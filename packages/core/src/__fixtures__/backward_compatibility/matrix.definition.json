{
    "id": "legacy-matrix",
    "version": "1.0.0",
    "title": "Legacy 4.0.1 coverage matrix",
    "description": "Hand-authored definition exercising the whole 4.0.1 surface: every field type, every validation rule, every condition operator, compound conditions, 3-level nesting, and conditions that reference non-scalar fields. Frozen - never edit to make a test pass.",
    "content": [
        {
            "id": 100,
            "type": "section",
            "title": "Sources",
            "description": "Fields referenced by the conditions below. None carry a condition themselves.",
            "content": [
                { "id": 1, "type": "string", "label": "Src string" },
                { "id": 2, "type": "number", "label": "Src number" },
                { "id": 3, "type": "boolean", "label": "Src boolean true" },
                { "id": 4, "type": "date", "label": "Src date" },
                {
                    "id": 5,
                    "type": "select",
                    "label": "Src select",
                    "options": [
                        { "value": "a", "label": "A" },
                        { "value": "b", "label": "B" },
                        { "value": "c", "label": "C" }
                    ]
                },
                { "id": 6, "type": "array", "label": "Src array", "item": { "type": "string", "label": "Entry" } },
                { "id": 7, "type": "file", "label": "Src file" },
                { "id": 8, "type": "string", "label": "Src unset" },
                {
                    "id": 9,
                    "type": "array",
                    "label": "Src empty array",
                    "item": { "type": "string", "label": "Entry" }
                },
                { "id": 10, "type": "boolean", "label": "Src boolean false" }
            ]
        },
        {
            "id": 200,
            "type": "section",
