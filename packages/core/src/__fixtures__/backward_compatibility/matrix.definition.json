                },
                {
                    "id": 209,
                    "type": "string",
                    "label": "op in",
                    "condition": { "field": 5, "op": "in", "value": ["a", "b"] }
                },
                {
                    "id": 210,
                    "type": "string",
                    "label": "op notin",
                    "condition": { "field": 5, "op": "notin", "value": ["a", "c"] }
                }
            ]
        },
