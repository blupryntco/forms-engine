        {
            "id": 260,
            "type": "section",
            "title": "Conditions referencing non-scalar fields",
            "description": "Pins 4.0.1 SCALAR semantics for array- and file-valued fields. The starred ids are the ones that would flip if set-oriented (multiselect) semantics ever leaked onto a legacy type.",
            "content": [
                {
                    "id": 261,
                    "type": "string",
                    "label": "array set (non-empty)",
                    "condition": { "field": 6, "op": "set" }
                },
                {
                    "id": 262,
                    "type": "string",
                    "label": "* array set (empty array counts as set)",
                    "condition": { "field": 9, "op": "set" }
                },
                {
                    "id": 263,
                    "type": "string",
                    "label": "* array notset (empty array is NOT notset)",
                    "condition": { "field": 9, "op": "notset" }
                },
                {
                    "id": 264,
                    "type": "string",
                    "label": "* array eq (compares by reference)",
                    "condition": { "field": 6, "op": "eq", "value": ["x", "y"] }
                },
                {
                    "id": 265,
                    "type": "string",
                    "label": "* array ne (compares by reference)",
                    "condition": { "field": 6, "op": "ne", "value": ["x", "y"] }
                },
                {
                    "id": 266,
                    "type": "string",
                    "label": "* array in (whole array, not members)",
                    "condition": { "field": 6, "op": "in", "value": ["x", "z"] }
                },
                {
                    "id": 267,
                    "type": "string",
                    "label": "* array notin (whole array, not members)",
                    "condition": { "field": 6, "op": "notin", "value": ["x", "z"] }
                },
                { "id": 269, "type": "string", "label": "file set", "condition": { "field": 7, "op": "set" } },
                { "id": 270, "type": "string", "label": "file notset", "condition": { "field": 7, "op": "notset" } },
                {
                    "id": 271,
                    "type": "string",
                    "label": "* file eq (compares by reference)",
                    "condition": {
                        "field": 7,
                        "op": "eq",
                        "value": {
                            "name": "a.pdf",
                            "mimeType": "application/pdf",
                            "size": 1024,
                            "url": "https://example.test/a.pdf"
                        }
                    }
                }
            ]
        },
        {
