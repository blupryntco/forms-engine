                {
                    "id": 203,
                    "type": "string",
                    "label": "op eq",
                    "condition": { "field": 1, "op": "eq", "value": "hello" }
                },
                {
                    "id": 204,
                    "type": "string",
                    "label": "op ne",
                    "condition": { "field": 1, "op": "ne", "value": "world" }
                },
                {
                    "id": 205,
                    "type": "string",
                    "label": "op lt",
                    "condition": { "field": 2, "op": "lt", "value": 100 }
                },
                { "id": 206, "type": "string", "label": "op gt", "condition": { "field": 2, "op": "gt", "value": 10 } },
                {
                    "id": 207,
                    "type": "string",
                    "label": "op lte",
                    "condition": { "field": 2, "op": "lte", "value": 42 }
                },
                {
                    "id": 208,
                    "type": "string",
                    "label": "op gte",
