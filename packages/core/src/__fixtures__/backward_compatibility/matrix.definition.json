        {
            "id": 240,
            "type": "section",
            "title": "Compound conditions",
            "content": [
                {
                    "id": 241,
                    "type": "string",
                    "label": "and true",
                    "condition": { "and": [{ "field": 1, "op": "set" }, { "field": 2, "op": "gt", "value": 10 }] }
                },
                {
                    "id": 242,
                    "type": "string",
                    "label": "and false",
                    "condition": { "and": [{ "field": 1, "op": "set" }, { "field": 2, "op": "gt", "value": 100 }] }
                },
                {
                    "id": 243,
                    "type": "string",
                    "label": "or true",
                    "condition": {
                        "or": [{ "field": 1, "op": "eq", "value": "nope" }, { "field": 2, "op": "gte", "value": 42 }]
                    }
                },
                {
                    "id": 244,
                    "type": "string",
                    "label": "or false",
                    "condition": {
                        "or": [{ "field": 1, "op": "eq", "value": "nope" }, { "field": 2, "op": "gte", "value": 43 }]
