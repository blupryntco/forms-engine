{
    "id": "c7e2a4f0-8b1d-4e3a-9f6c-d5a2b8e1c4f7",
    "version": "1.0.0",
    "title": "Travel Rule Compliance Report",
    "description": "Submit travel rule transaction data and supporting documentation for regulatory compliance",
    "content": [
        {
            "id": 1,
            "type": "section",
            "title": "Transaction Details",
            "content": [
                {
                    "id": 2,
                    "type": "string",
                    "label": "Transaction hash",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 3,
                    "type": "select",
                    "label": "Blockchain network",
                    "options": [
                        {
                            "value": "bitcoin",
                            "label": "Bitcoin"
                        },
                        {
                            "value": "ethereum",
                            "label": "Ethereum"
                        },
                        {
                            "value": "polygon",
                            "label": "Polygon"
                        },
                        {
                            "value": "solana",
                            "label": "Solana"
                        },
                        {
                            "value": "tron",
                            "label": "TRON"
                        },
                        {
                            "value": "other",
                            "label": "Other"
                        }
                    ],
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 4,
                    "type": "date",
                    "label": "Transaction date",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 5,
                    "type": "number",
                    "label": "Transaction amount (USD equivalent)",
                    "validation": {
                        "required": true,
                        "min": 0
                    }
                },
                {
                    "id": 6,
                    "type": "select",
                    "label": "Transfer direction",
                    "options": [
                        {
                            "value": "outgoing",
                            "label": "Outgoing"
                        },
                        {
                            "value": "incoming",
                            "label": "Incoming"
                        }
                    ],
                    "validation": {
                        "required": true
                    }
                }
            ]
        },
        {
            "id": 7,
            "type": "section",
            "title": "Originator Information",
            "content": [
                {
                    "id": 8,
                    "type": "string",
                    "label": "Originator name",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 9,
                    "type": "string",
                    "label": "Originator wallet address",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 10,
                    "type": "string",
                    "label": "Originator institution (counterparty VASP)",
                    "condition": {
                        "field": 6,
                        "op": "eq",
                        "value": "incoming"
                    },
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 11,
                    "type": "file",
                    "label": "Originator identity verification",
                    "validation": {
                        "required": true
                    }
                }
            ]
        },
        {
            "id": 12,
            "type": "section",
            "title": "Beneficiary Information",
            "content": [
                {
                    "id": 13,
                    "type": "string",
                    "label": "Beneficiary name",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 14,
                    "type": "string",
                    "label": "Beneficiary wallet address",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 15,
                    "type": "string",
                    "label": "Beneficiary institution (counterparty VASP)",
                    "condition": {
                        "field": 6,
                        "op": "eq",
                        "value": "outgoing"
                    },
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 16,
                    "type": "file",
                    "label": "Beneficiary identity verification"
                }
            ]
        },
        {
            "id": 17,
            "type": "section",
            "title": "Compliance Documentation",
            "content": [
                {
                    "id": 18,
                    "type": "file",
                    "label": "Transaction screening report",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 19,
                    "type": "boolean",
                    "label": "Enhanced due diligence required?",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 20,
                    "type": "file",
                    "label": "EDD report",
                    "condition": {
                        "field": 19,
                        "op": "eq",
                        "value": true
                    }
                },
                {
                    "id": 21,
                    "type": "array",
                    "label": "Supporting documents",
                    "item": {
                        "type": "file",
                        "label": "Document"
                    },
                    "validation": {
                        "maxItems": 10
                    }
                },
                {
                    "id": 22,
                    "type": "string",
                    "label": "Compliance officer notes",
                    "validation": {
                        "maxLength": 5000
                    }
                }
            ]
        },
        {
            "id": 23,
            "type": "section",
            "title": "Attestation",
            "content": [
                {
                    "id": 24,
                    "type": "string",
                    "label": "Compliance officer name",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 25,
                    "type": "date",
                    "label": "Review date",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 26,
                    "type": "boolean",
                    "label": "I confirm travel rule obligations have been met for this transaction",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 27,
                    "type": "boolean",
                    "label": "I confirm all originator and beneficiary data is complete and accurate",
                    "validation": {
                        "required": true
                    }
                }
            ]
        }
    ]
}
