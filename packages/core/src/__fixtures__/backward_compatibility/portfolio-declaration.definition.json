{
    "id": "e4a7c1b2-3d5f-4890-abef-1234567890ab",
    "version": "1.0.0",
    "title": "Digital Asset Portfolio Declaration",
    "description": "Declare digital asset holdings with per-position data and evidence for regulatory compliance. Demonstrates all array item types.",
    "content": [
        {
            "id": 1,
            "type": "section",
            "title": "Declarant Information",
            "content": [
                {
                    "id": 2,
                    "type": "string",
                    "label": "Declaring entity name",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 3,
                    "type": "string",
                    "label": "Declaration reference number",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 4,
                    "type": "date",
                    "label": "Declaration effective date",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 5,
                    "type": "select",
                    "label": "Declaration type",
                    "options": [
                        {
                            "value": "initial",
                            "label": "Initial Declaration"
                        },
                        {
                            "value": "periodic",
                            "label": "Periodic Update"
                        },
                        {
                            "value": "event-driven",
                            "label": "Event-Driven Update"
                        }
                    ],
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 6,
                    "type": "string",
                    "label": "Triggering event description",
                    "condition": {
                        "field": 5,
                        "op": "eq",
                        "value": "event-driven"
                    },
                    "validation": {
                        "required": true,
                        "minLength": 10
                    }
                }
            ]
        },
        {
            "id": 7,
            "type": "section",
            "title": "Wallet Registry",
            "description": "Array of string — all wallet addresses under entity control",
            "content": [
                {
                    "id": 8,
                    "type": "array",
                    "label": "Controlled wallet addresses",
                    "item": {
                        "type": "string",
                        "label": "Wallet address",
                        "validation": {
                            "required": true
                        }
                    },
                    "validation": {
                        "minItems": 1,
                        "maxItems": 100
                    }
                },
                {
                    "id": 9,
                    "type": "select",
                    "label": "Primary blockchain network",
                    "options": [
                        {
                            "value": "ethereum",
                            "label": "Ethereum"
                        },
                        {
                            "value": "bitcoin",
                            "label": "Bitcoin"
                        },
                        {
                            "value": "solana",
                            "label": "Solana"
                        },
                        {
                            "value": "polygon",
                            "label": "Polygon"
                        },
                        {
                            "value": "multi",
                            "label": "Multi-chain"
                        }
                    ],
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 10,
                    "type": "array",
                    "label": "Additional chain identifiers",
                    "item": {
                        "type": "string",
                        "label": "Chain name or ID"
                    },
                    "condition": {
                        "field": 9,
                        "op": "eq",
                        "value": "multi"
                    },
                    "validation": {
                        "minItems": 2,
                        "maxItems": 20
                    }
                }
            ]
        },
        {
            "id": 11,
            "type": "section",
            "title": "Position Valuations",
            "description": "Array of number — USD value for each declared position",
            "content": [
                {
                    "id": 12,
                    "type": "array",
                    "label": "Individual position values (USD)",
                    "item": {
                        "type": "number",
                        "label": "Position value (USD)",
                        "validation": {
                            "required": true,
                            "min": 0
                        }
                    },
                    "validation": {
                        "minItems": 1,
                        "maxItems": 100
                    }
                },
                {
                    "id": 13,
                    "type": "number",
                    "label": "Total declared portfolio value (USD)",
                    "validation": {
                        "required": true,
                        "min": 0
                    }
                }
            ]
        },
        {
            "id": 14,
            "type": "section",
            "title": "Risk Classifications",
            "description": "Array of select — risk category assigned to each position",
            "content": [
                {
                    "id": 15,
                    "type": "array",
                    "label": "Position risk classifications",
                    "item": {
                        "type": "select",
                        "label": "Risk classification",
                        "options": [
                            {
                                "value": "low",
                                "label": "Low Risk"
                            },
                            {
                                "value": "medium",
                                "label": "Medium Risk"
                            },
                            {
                                "value": "high",
                                "label": "High Risk"
                            },
                            {
                                "value": "prohibited",
                                "label": "Prohibited"
                            }
                        ]
                    },
                    "validation": {
                        "minItems": 1,
                        "maxItems": 100
                    }
                }
            ]
        },
        {
            "id": 16,
            "type": "section",
            "title": "Compliance Review Dates",
            "description": "Array of date — last compliance review date per position",
            "content": [
                {
                    "id": 17,
                    "type": "array",
                    "label": "Last compliance review dates",
                    "item": {
                        "type": "date",
                        "label": "Review date"
                    },
                    "validation": {
                        "maxItems": 100
                    }
                },
                {
                    "id": 18,
                    "type": "date",
                    "label": "Next scheduled portfolio-wide review"
                }
            ]
        },
        {
            "id": 19,
            "type": "section",
            "title": "Sanctions Screening",
            "description": "Array of boolean — pass/fail screening result per position",
            "content": [
                {
                    "id": 20,
                    "type": "array",
                    "label": "Sanctions screening results (pass = true)",
                    "item": {
                        "type": "boolean",
                        "label": "Passed sanctions screening"
                    },
                    "validation": {
                        "minItems": 1,
                        "maxItems": 100
                    }
                },
                {
                    "id": 21,
                    "type": "boolean",
                    "label": "All positions passed sanctions screening?",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 22,
                    "type": "string",
                    "label": "Explain screening failures and remediation steps",
                    "condition": {
                        "field": 21,
                        "op": "eq",
                        "value": false
                    },
                    "validation": {
                        "required": true,
                        "minLength": 20
                    }
                }
            ]
        },
        {
            "id": 23,
            "type": "section",
            "title": "Evidence Package",
            "description": "Array of file — supporting documents for each position",
            "content": [
                {
                    "id": 24,
                    "type": "array",
                    "label": "Position-level evidence documents",
                    "item": {
                        "type": "file",
                        "label": "Evidence document"
                    },
                    "validation": {
                        "minItems": 1,
                        "maxItems": 50
                    }
                },
                {
                    "id": 25,
                    "type": "file",
                    "label": "Consolidated portfolio report"
                },
                {
                    "id": 26,
                    "type": "string",
                    "label": "Compliance officer notes",
                    "validation": {
                        "maxLength": 5000
                    }
                }
            ]
        },
        {
            "id": 27,
            "type": "section",
            "title": "Attestation",
            "content": [
                {
                    "id": 28,
                    "type": "string",
                    "label": "Compliance officer name",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 29,
                    "type": "date",
                    "label": "Attestation date",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 30,
                    "type": "boolean",
                    "label": "I confirm all declared positions and valuations are accurate and complete",
                    "validation": {
                        "required": true
                    }
                },
                {
                    "id": 31,
                    "type": "boolean",
                    "label": "I confirm all required sanctions screening has been completed",
                    "validation": {
                        "required": true
                    }
                }
            ]
        }
    ]
}
